<Window
    x:Class="MusicPlayer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MusicPlayer.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Music Player (Windows)">

    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="2*,2*,1.5*" ColumnSpacing="12" RowSpacing="12">
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
            <Button Content="フォルダ追加" Click="AddFolderButton_Click" />
            <Button Content="スキャン実行" Click="ScanButton_Click" />
            <Button Content="M3U読込" Click="ImportPlaylistButton_Click" />
            <TextBox Width="300" PlaceholderText="検索 (曲/アーティスト/アルバム)" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="140" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ProgressBar Width="300" Height="8" Minimum="0" Maximum="1" Value="{Binding ScanProgress}" />
            <TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" />
            <TextBlock Text=" - " />
            <TextBlock Text="{Binding CurrentArtist}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="前へ" Click="PrevButton_Click" />
            <Button Content="{Binding PlayPauseLabel}" Click="PlayPauseButton_Click" />
            <Button Content="次へ" Click="NextButton_Click" />
            <Button Content="{Binding ShuffleLabel}" Click="ShuffleButton_Click" />
            <Button Content="{Binding RepeatModeLabel}" Click="RepeatButton_Click" />
            <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" />
            <Slider Width="260" Minimum="0" Maximum="1" Value="{Binding PositionRatio, Mode=TwoWay}" ValueChanged="PositionSlider_ValueChanged" />
            <TextBlock Text="{Binding DurationText}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="6">
            <TextBlock Text="ライブラリ" FontSize="16" FontWeight="Bold" />
            <ListView ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong, Mode=TwoWay}" DoubleTapped="SongsList_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Artist}" Opacity="0.8" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
            <TextBlock Text="再生キュー" FontSize="16" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="↑" Click="QueueUpButton_Click" />
                <Button Content="↓" Click="QueueDownButton_Click" />
            </StackPanel>
            <ListView ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueueSong, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="2" Spacing="6">
            <TextBlock Text="プレイリスト" FontSize="16" FontWeight="Bold" />
            <ListView ItemsSource="{Binding Playlists}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Songs.Count}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="追加したフォルダ" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" />
            <ListView ItemsSource="{Binding SourceFolders}" />
        </StackPanel>
    </Grid>
</Window>
