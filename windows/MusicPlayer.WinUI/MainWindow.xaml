<Window
    x:Class="MusicPlayer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MusicPlayer (WinUI)">

    <Grid Padding="16" RowSpacing="12" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PickFolderButton" Content="フォルダ追加" Click="OnPickFolderClick" />
            <Button x:Name="ScanButton" Content="再スキャン" Click="OnScanClick" />
            <Button x:Name="ImportPlaylistButton" Content="M3U読み込み" Click="OnImportPlaylistClick" />
            <TextBox x:Name="BasePathTextBox" PlaceholderText="M3Uベースパス (例: C:\\Music)" Width="280" />
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="SearchTextBox" PlaceholderText="曲名・アーティストで検索" TextChanged="OnSearchTextChanged" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="SongsListView" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnSongItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding Artist}" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="プレイリスト" FontWeight="SemiBold" />
                <ListView x:Name="PlaylistsListView" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnPlaylistItemClick" Height="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding SongCountText}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="再生キュー" FontWeight="SemiBold" />
                <ListView x:Name="QueueListView" Height="260">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock x:Name="NowPlayingText" Text="再生中: なし" />
            <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" ValueChanged="OnPositionSliderChanged" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button Content="⏮" Click="OnPrevClick" />
                <Button x:Name="PlayPauseButton" Content="再生" Click="OnPlayPauseClick" />
                <Button Content="⏭" Click="OnNextClick" />
                <Button x:Name="ShuffleButton" Content="シャッフル: OFF" Click="OnShuffleClick" />
                <Button x:Name="RepeatButton" Content="リピート: OFF" Click="OnRepeatClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
